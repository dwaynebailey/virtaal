msgstr "‮⊥ɹɐusʅɐʇıou _Snƃƃǝsʇıous"

#: ../virtaal/plugins/tm/tmview.py:150
#, python-format
msgid "Ctrl+%(number_key)d"
msgstr "‮Ↄʇɹʅ+%(number_key)d"

