msgstr "‮Sǝʅǝɔʇ sonɹɔǝs oɟ ⊥ɹɐusʅɐʇıou Wǝɯoɹʎ"

#: ../virtaal/plugins/tm/tmview.py:175
msgid "Select the sources that should be queried for translation memory"
msgstr "‮Sǝʅǝɔʇ ʇɥǝ sonɹɔǝs ʇɥɐʇ sɥonʅp qǝ bnǝɹıǝp ɟoɹ ʇɹɐusʅɐʇıou ɯǝɯoɹʎ"

