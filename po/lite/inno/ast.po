#. Setup's title bar and taskbar button.
msgctxt "SetupAppTitle"
msgid "Setup"
msgstr "Instalar"

#. Setup's title bar and taskbar button.
#. Setup fills in %1 (and %2, ...): keep each one.
#, qt-format
msgctxt "SetupWindowTitle"
msgid "Setup - %1"
msgstr "Instalar - %1"

#. A button on the wizard's pages or its message boxes.
msgctxt "ButtonBack"
msgid "< &Back"
msgstr "< &Tornar"

#. A button on the wizard's pages or its message boxes.
msgctxt "ButtonNext"
msgid "&Next >"
msgstr "&Seguir >"

#. A button on the wizard's pages or its message boxes.
msgctxt "ButtonInstall"
msgid "&Install"
msgstr "&Instalar"

#. A button on the wizard's pages or its message boxes.
msgctxt "ButtonOK"
