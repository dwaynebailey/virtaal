<?xml version="1.0"?>
<!--
No built-in gettext ITS rule exists for shared-mime-info XML (unlike
.desktop, GtkBuilder, or AppStream metainfo) - this fills that gap for
xgettext/msgfmt extraction of virtaal-mimetype.xml.in.
-->
<its:rules xmlns:its="http://www.w3.org/2005/11/its" version="2.0">
  <its:translateRule selector="/mime-info" translate="no"/>
  <its:translateRule selector="//comment | //acronym | //expanded-acronym"
                     translate="yes"/>
</its:rules>
