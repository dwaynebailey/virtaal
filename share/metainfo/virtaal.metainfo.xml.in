    <_caption>Easy access to recent files and documentation</_caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/dwaynebailey/virtaal/py3/docs/_static/appdata/placeable.png</image>
    <_caption>Recognized elements don't need to be typed</_caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/dwaynebailey/virtaal/py3/docs/_static/appdata/window.png</image>
    <_caption>Quality checks while you type</_caption>
  </screenshot>
 </screenshots>
